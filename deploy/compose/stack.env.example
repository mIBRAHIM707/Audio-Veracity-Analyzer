# Copy to a file OUTSIDE the repository (for example D:/AVA-Data/deploy/stack.env),
# fill in the values and pass it with `docker compose --env-file <that file>`. Never
# commit the filled-in copy: it holds the passwords and the local model paths.
AVA_ARI_PASSWORD=replace-with-at-least-16-letters-or-digits
AVA_DB_PASSWORD=replace-with-a-long-random-password
# Folders on this host, mounted read-only into the live container:
AVA_ONNX_DIR=D:/AVA-Data/exports/your-export-folder
AVA_ONNX_FILE=your-export.onnx
AVA_CARD_DIR=D:/AVA-Data/exports/your-card-folder
AVA_CARD_FILE=model_card.json
AVA_VAD_DIR=D:/AVA-Data/models/silero-vad/6.2.3
# Optional (defaults shown): the lab PBX inside the stack, extension 700, 4 threads.
# AVA_ARI_URL=http://asterisk:8088
# AVA_ARI_USER=ava
# AVA_TAP_EXTENSION=700
# AVA_THREADS=4
