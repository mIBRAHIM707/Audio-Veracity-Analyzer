{
  "uid": "ava-overview",
  "title": "AVA overview (lab)",
  "description": "Backlog 7.2, PRD FR-O6: latency per stage, queue depth, active calls, alerts per minute, dropped windows, plus media quality, storage and the analysis API. Advisory detector; scores from an untrained or uncalibrated model carry no accuracy meaning.",
  "tags": ["ava", "fr-o6"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [],
  "panels": [
    {"id": 1, "type": "row", "title": "Live scorer (job ava-live)", "collapsed": false,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"id": 2, "type": "stat", "title": "Scrape targets up",
     "description": "Prometheus `up` per job: 0 means the target did not answer the last scrape.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
     "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 1}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "expr": "up{job=~\"ava-.*\"}", "legendFormat": "{{job}}"}]},
    {"id": 3, "type": "stat", "title": "Live scorer ready",
     "description": "1 while the live /readyz would answer 200 (ARI stream connected, scoring loop turning, detector not failing); 0 also when the live scorer is not answering scrapes. Calls go on either way: AVA is advisory.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
     "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 1}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "expr": "ava_live_ready or on() (up{job=\"ava-live\"} * 0)", "legendFormat": "ready"}]},
    {"id": 4, "type": "timeseries", "title": "Active calls and capacity",
     "description": "FR-O6 active calls: calls admitted for scoring, the max_calls capacity, and calls not scored because capacity was full (per minute).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "ava_live_calls_active", "legendFormat": "active"},
       {"refId": "B", "expr": "ava_live_calls_capacity", "legendFormat": "capacity"},
       {"refId": "C", "expr": "rate(ava_live_calls_refused_capacity_total[5m]) * 60", "legendFormat": "refused per minute"}]},
    {"id": 5, "type": "timeseries", "title": "Alerts per minute",
     "description": "FR-O6 alerts per minute: alert.raised events published by the live loop (rate over 5 minutes x 60).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 4, "w": 12, "x": 0, "y": 5},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "expr": "rate(ava_live_alerts_raised_total[5m]) * 60", "legendFormat": "alerts per minute"}]},
    {"id": 6, "type": "timeseries", "title": "Queue depth",
     "description": "FR-O6 queue depth: windows waiting in per-direction queues and live windows in the micro-batcher.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "ava_live_windows_waiting", "legendFormat": "waiting"},
       {"refId": "B", "expr": "ava_live_windows_in_batcher", "legendFormat": "in batcher"}]},
    {"id": 7, "type": "timeseries", "title": "Dropped windows per minute",
     "description": "FR-O6 dropped windows: accepted windows that ended without a score, by exclusive outcome, and offered windows skipped by a grown stride (FR-I10).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "sum by (outcome) (rate(ava_live_windows_resolved_total{outcome!=\"scored\"}[5m])) * 60", "legendFormat": "{{outcome}}"},
       {"refId": "B", "expr": "rate(ava_live_windows_offered_total{outcome=\"stride_skipped\"}[5m]) * 60", "legendFormat": "stride skipped"}]},
    {"id": 8, "type": "timeseries", "title": "Live loop latency per stage (p95)",
     "description": "FR-O6 latency per stage: 95th percentile over 5 minutes of queue_wait, batch_wait, apply and window_to_result (offer to result applied), plus jitter_hold (an RTP frame read off the socket by the loop to handed to scoring: the 60 ms buffer delay plus loop-turn quantisation, up to about 50 ms either way; socket wait is not included, so this is not a measurement against the 60 ms budget).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
     "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(ava_live_stage_seconds_bucket[5m])))", "legendFormat": "{{stage}}"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ava_live_jitter_hold_seconds_bucket[5m])))", "legendFormat": "jitter_hold"}]},
    {"id": 9, "type": "timeseries", "title": "Detector call time per batch",
     "description": "Live detector call time (successful batches), median and 95th percentile over 5 minutes.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
     "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(ava_live_inference_seconds_bucket{outcome=\"ok\"}[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ava_live_inference_seconds_bucket{outcome=\"ok\"}[5m])))", "legendFormat": "p95"}]},
    {"id": 10, "type": "timeseries", "title": "Tap processing cost",
     "description": "Per stage (resample, speech_feed): tap processing time per second of tapped audio (the cost of one call). Busy: tap processing time per second of wall clock over all calls; the tap runs on the service's one loop thread, which also runs scoring, so the loop falls behind well before busy reaches 100 %.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "sum by (stage) (rate(ava_live_tap_stage_seconds_sum[5m])) / sum by (stage) (rate(ava_live_tap_audio_seconds_total[5m]))", "legendFormat": "{{stage}} per audio second"},
       {"refId": "B", "expr": "sum(rate(ava_live_tap_stage_seconds_sum[5m]))", "legendFormat": "busy (fraction of wall time)"}]},
    {"id": 11, "type": "timeseries", "title": "Degraded and unmonitored",
     "description": "Visible unmonitored and low-quality conditions: directions scoring at a grown stride or at the cap (unmonitored, FR-I10), the largest effective stride, and tapped calls in sustained packet loss (FR-I2 media_quality).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": [
       {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "unit", "value": "s"}]}]},
     "targets": [
       {"refId": "A", "expr": "ava_live_directions_degraded", "legendFormat": "directions degraded"},
       {"refId": "B", "expr": "ava_live_directions_unmonitored", "legendFormat": "directions unmonitored"},
       {"refId": "C", "expr": "ava_live_max_effective_stride_seconds", "legendFormat": "max stride (s)"},
       {"refId": "D", "expr": "ava_live_rtp_calls_degraded", "legendFormat": "calls in sustained loss"}]},
    {"id": 12, "type": "timeseries", "title": "RTP loss and concealment per second",
     "description": "Packets received, packets missing (sequence gaps) and frames concealed by the jitter buffer, per second, over ended calls and calls in progress.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "rate(ava_live_rtp_receiver_total{kind=\"packets\"}[5m])", "legendFormat": "packets"},
       {"refId": "B", "expr": "rate(ava_live_rtp_receiver_total{kind=\"missing\"}[5m])", "legendFormat": "missing"},
       {"refId": "C", "expr": "rate(ava_live_jitter_buffer_total{kind=\"concealed_frames\"}[5m])", "legendFormat": "concealed frames"}]},
    {"id": 13, "type": "timeseries", "title": "Detector and loop health",
     "description": "Detector batches failing per minute, the current failure run, the age of the last loop snapshot (grows when the loop stalls) and ARI stream drops in the last 5 minutes.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": [
       {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "unit", "value": "s"}]}]},
     "targets": [
       {"refId": "A", "expr": "rate(ava_live_detector_failures_total[5m]) * 60", "legendFormat": "detector failures per minute"},
       {"refId": "B", "expr": "ava_live_detector_failure_run", "legendFormat": "failure run"},
       {"refId": "C", "expr": "ava_live_pipeline_snapshot_age_seconds", "legendFormat": "loop snapshot age (s)"},
       {"refId": "D", "expr": "increase(ava_live_ari_disconnects_total[5m])", "legendFormat": "ARI drops (5 min)"}]},
    {"id": 14, "type": "timeseries", "title": "Storage and event publishing",
     "description": "Events waiting for PostgreSQL, store attempts failed in a row, Redis publish failures per minute and whether each pump thread runs.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 24, "x": 0, "y": 41},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "ava_live_store_backlog", "legendFormat": "store backlog"},
       {"refId": "B", "expr": "ava_live_store_consecutive_failures", "legendFormat": "store failures in a row"},
       {"refId": "C", "expr": "rate(ava_live_redis_publish_failures_total[5m]) * 60", "legendFormat": "Redis publish failures per minute"},
       {"refId": "D", "expr": "ava_live_pump_alive", "legendFormat": "pump {{pump}} alive"}]},
    {"id": 20, "type": "row", "title": "Analysis API (job ava-api)", "collapsed": false,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 49}, "panels": []},
    {"id": 21, "type": "timeseries", "title": "API responses per second",
     "description": "HTTP responses by fixed route label and status class, without the probe routes (/healthz, /readyz, /metrics), which the health check and Prometheus call every few seconds.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 50},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (route, status) (rate(ava_api_requests_total{route!~\"/healthz|/readyz|/metrics\"}[5m]))", "legendFormat": "{{route}} {{status}}"}]},
    {"id": 22, "type": "timeseries", "title": "File analysis time per stage (p95)",
     "description": "FR-O6 latency per stage for file analysis: decode, condition and inference, 95th percentile over 5 minutes (completed analyses only).",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 50},
     "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(ava_analysis_stage_seconds_bucket[5m])))", "legendFormat": "{{stage}}"}]},
    {"id": 23, "type": "timeseries", "title": "File job queue",
     "description": "FR-O6 queue depth for file analysis: queued jobs, the queue capacity and uploads in flight.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 58},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "ava_job_queue_depth", "legendFormat": "queued"},
       {"refId": "B", "expr": "ava_job_queue_capacity", "legendFormat": "capacity"},
       {"refId": "C", "expr": "ava_uploads_in_flight", "legendFormat": "uploads in flight"}]},
    {"id": 24, "type": "timeseries", "title": "Event relay to the dashboard",
     "description": "Whether the API holds its Redis subscription, events counted lost in the last 5 minutes (sequence gaps) and Redis outages, plus WebSocket and registry subscribers.",
     "datasource": {"type": "prometheus", "uid": "ava-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 58},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "ava_event_relay_subscribed", "legendFormat": "subscribed"},
       {"refId": "B", "expr": "increase(ava_event_relay_missing_events_total[5m])", "legendFormat": "events lost (5 min)"},
       {"refId": "C", "expr": "increase(ava_event_relay_interruptions_total[5m])", "legendFormat": "Redis outages (5 min)"},
       {"refId": "D", "expr": "ava_event_subscribers", "legendFormat": "hub subscribers"}]}
  ]
}
